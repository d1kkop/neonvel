# /etc/neonvel.env on the server (chmod 600). Fill in, then: systemctl restart neonvel
PUBLIC_URL=https://neonvel.example/

# Sign-in (callback URLs to register with Google / Discord:
#   https://neonvel.example/auth/google/callback   https://neonvel.example/auth/discord/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Stripe (start with the sk_test_ key; webhook endpoint: https://neonvel.example/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX=1
STORE_CURRENCY=eur
# No free test purchases on the live server:
STORE_TEST_MODE=0
